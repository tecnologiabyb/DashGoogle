{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/auth",
      "destination": "/api/index.js"
    },
    {
      "source": "/oauth2callback",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/check-budgets",
      "schedule": "0 11 * * *"
    }
  ]
}
